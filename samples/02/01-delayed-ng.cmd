@echo off
rem ============================================================
rem  01-delayed-ng.cmd  第2回  失敗版
rem   通常の展開でループを回すと値が更新されない
rem   01-delayed-ok.cmd と見比べること
rem ============================================================
setlocal

set "COUNT=0"

echo === カレントのファイルを数える（失敗版） ===
for %%f in ("%~dp0*.cmd") do (
	set /a COUNT+=1
	echo 現在: %COUNT%   ... 通常の展開なので 0 のまま
)

echo.
echo ループの外では正しい値になる: %COUNT%
echo.
echo 理由: 括弧ブロックは1つの論理行。中に入る前に全体が1回だけ
echo       置換されるため、ブロック内の表示は 0 に焼き付いている
pause
