@echo off
rem ============================================================
rem  01-hello.cmd  第1回
rem   echo と rem の確認
rem
rem  実験: 1行目の @echo off を rem でコメントアウトして実行すると、
rem        実行される1行1行が展開後の姿で表示される（デバッグの基本）
rem ============================================================

echo こんにちは
echo.
echo 上の行は echo. で空行を出しています

rem この行はコメントなので表示されません

echo 終わりです
pause
